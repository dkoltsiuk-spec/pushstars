# Unity (generated / local)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa/*
/ota_public/ota/
/[Aa]ssets/_Project/OTA/Generated/*.unity

# Unity Package Manager cache (not needed in source)
/[Pp]ackages/packages-lock.json

# Asset meta noise when using plastic/git partial workflows — keep if needed:
# *.pidb.meta
# *.pdb.meta

# Gradle / Android (Unity Android builds)
.gradle/
*.apk
*.aab
*.unitypackage

# Autogenerated VS / Rider / VSCode
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# Crash / profiling
sysinfo.txt
*.stackdump

# Firebase / mobile config — храним только локально (фаза 04, решение: не коммитить).
# Это клиентские конфиги; на новой машине положить вручную (см. credentials-checklist.md).
GoogleService-Info.plist
GoogleService-Info.plist.meta
google-services.json
google-services.json.meta
**/google-services.json
# Сгенерированный Firebase-редактором десктоп-конфиг (тоже содержит ключи):
Assets/StreamingAssets/google-services-desktop.json
Assets/StreamingAssets/google-services-desktop.json.meta

# Firebase desktop native libs for OTHER OSes — exceed GitHub's 100MB limit and aren't
# needed on this Windows project (Editor uses the .dll; iOS/Android use their own plugin
# dirs). Re-imported automatically when the Firebase Unity SDK is imported.
Assets/Firebase/Plugins/x86_64/*.bundle
Assets/Firebase/Plugins/x86_64/*.so

# Node (будущий functions/, фаза 05)
functions/node_modules/
functions/.env

# MediaPipeUnityPlugin (Homuler, фаза 08) — ~391 МБ нативных либ под все платформы,
# в git не тащим. На новой машине импортировать MediaPipeUnity.0.16.3.unitypackage
# из релизов github.com/homuler/MediaPipeUnityPlugin, затем Tools → Push Stars → MediaPipe → Enable.
Packages/com.github.homuler.mediapipe/
Assets/MediaPipeUnity/
Assets/MediaPipeUnity.meta

# Модели Pose Landmarker (~15 МБ) — копии из пакета выше, их кладёт в StreamingAssets
# BuildScript.CopyModelToStreamingAssets перед каждой сборкой (и локально, и на CI).
# Источник в git не тащим — значит и копию тоже нет.
Assets/StreamingAssets/pose_landmarker_*.bytes
Assets/StreamingAssets/pose_landmarker_*.bytes.meta

# Unity license activation files — НЕ коммитить (это лицензия/секрет). Для CI .ulf хранится
# как секрет UNITY_LICENSE в Codemagic, не в git.
*.alf
*.ulf

# iOS signing — приватный ключ/сертификат/профиль НИКОГДА не коммитить.
/signing/
*.key
*.csr
*.cer
*.p12
*.mobileprovision

# Scratch output of Tools > Push Stars > Dump Main Screen Layout
layout_dump.txt
