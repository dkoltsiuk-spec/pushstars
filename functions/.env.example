# Скопируй в .env только для локальной отладки Functions (emulator).
# Файл .env не коммитится. В проде используй Firebase secrets / functions:config:set.

# Photon — webhook проверка входящего запроса от Photon (фаза 13)
PHOTON_WEBHOOK_SECRET=

# Photon REST не используется: комнату боя с другом создают сами клиенты (docs/architecture/live-duel.md).
# Тот же секрет укажи в Photon Dashboard → Webhooks → CustomHttpHeaders {"X-Photon-Token": "..."}.

# Опционально: URL webhook после деплоя (для копирования в Photon Dashboard)
# ON_MATCH_FINISHED_URL=https://REGION-PROJECT_ID.cloudfunctions.net/onMatchFinished
